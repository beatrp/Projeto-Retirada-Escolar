---
title: QRStudy – Diagrama de Classes
---
classDiagram
    direction TB

    %% ===================== USUÁRIOS =====================
    class Usuario {
        <<abstract>>
        +UUID id
        +String nome
        +String email
        +String senhaHash
        +PerfilUsuario perfil
        +boolean ativo
        +int tentativasFalhas
        +DateTime bloqueadoAte
        +autenticar(email, senha) boolean
        +recuperarSenha() void
        +redefinirSenha(token, novaSenha) void
    }

    class Administrador {
        +cadastrarAluno(dados) Aluno
        +validarCadastro(responsavel, aprovado, motivo) void
        +vincularResponsavel(responsavel, aluno) Vinculo
        +revogarVinculo(vinculo, motivo) void
        +cadastrarFuncionario(dados) FuncionarioPortaria
        +desativarFuncionario(funcionario) void
        +editarCadastro(entidade) void
        +inativarCadastro(entidade) void
        +consultarHistorico(filtro) List~Retirada~
    }

    class FuncionarioPortaria {
        +validarQRCode(token) ResultadoValidacao
        +consultarRetiradasDoDia() List~Retirada~
    }

    class Responsavel {
        +String nomeCompleto
        +String documentoCriptografado
        +String documentoHash
        +String telefone
        +String cnh
        +StatusCadastro statusCadastro
        +String motivoRejeicao
        +boolean consentimentoLGPD
        +DateTime dataConsentimento
        +enviarDocumento(arquivo) Documento
        +gerarQRCode(vinculo) QRCode
        +autorizarRetiradaEmergencial(dados) AutorizacaoEmergencial
        +consultarHistorico() List~Retirada~
    }

    %% ===================== ESCOLA E ALUNO =====================
    class Escola {
        +UUID id
        +String nome
        +String cnpj
        +String endereco
        +String telefone
        +String emailInstitucional
        +boolean emailConfirmado
        +StatusEscola status
        +cadastrar() void
        +confirmarEmail() void
    }

    class Aluno {
        +UUID id
        +String nomeCompleto
        +Date dataNascimento
        +String matriculaRA
        +String cpf
        +String serieTurma
        +boolean ativo
    }

    %% ===================== RESPONSÁVEL: DADOS COMPLEMENTARES =====================
    class Veiculo {
        +UUID id
        +String placa
        +String modelo
        +String cor
    }

    class Documento {
        +UUID id
        +String nomeArquivo
        +TipoArquivo tipo
        +long tamanhoBytes
        +String caminhoProtegido
        +DateTime dataEnvio
    }

    %% ===================== AUTORIZAÇÃO E RETIRADA =====================
    class Vinculo {
        +UUID id
        +DateTime dataVinculo
        +StatusVinculo status
        +String motivoRevogacao
        +DateTime dataRevogacao
        +revogar(motivo) void
        +estaAtivo() boolean
    }

    class QRCode {
        +UUID id
        +String token
        +TipoQRCode tipo
        +StatusQRCode status
        +DateTime dataGeracao
        +DateTime dataExpiracao
        +estaValido() boolean
        +expirar() void
        +revogar() void
        +marcarComoUsado() void
    }

    class AutorizacaoEmergencial {
        +UUID id
        +String nomeTerceiro
        +String documentoTerceiro
        +DateTime inicioValidade
        +DateTime fimValidade
        +boolean aprovadaNaPortaria
    }

    class Retirada {
        +UUID id
        +DateTime dataHora
        +boolean validadaOffline
        +DateTime sincronizadoEm
        +registrar() void
    }

    class LogAuditoria {
        +UUID id
        +String acao
        +String entidade
        +UUID entidadeId
        +String detalhes
        +DateTime dataHora
    }

    %% ===================== ENUMERAÇÕES =====================
    class PerfilUsuario {
        <<enumeration>>
        ADMINISTRADOR
        FUNCIONARIO_PORTARIA
        RESPONSAVEL
    }

    class StatusCadastro {
        <<enumeration>>
        PENDENTE
        APROVADO
        REJEITADO
        INATIVO
    }

    class StatusEscola {
        <<enumeration>>
        PENDENTE_CONFERENCIA
        ATIVA
        INATIVA
    }

    class StatusVinculo {
        <<enumeration>>
        ATIVO
        REVOGADO
    }

    class StatusQRCode {
        <<enumeration>>
        ATIVO
        USADO
        EXPIRADO
        REVOGADO
    }

    class TipoQRCode {
        <<enumeration>>
        RETIRADA_FIXA
        EMERGENCIAL
    }

    class TipoArquivo {
        <<enumeration>>
        PDF
        JPG
        PNG
    }

    %% ===================== HERANÇA =====================
    Usuario <|-- Administrador
    Usuario <|-- FuncionarioPortaria
    Usuario <|-- Responsavel

    %% ===================== ASSOCIAÇÕES =====================
    Escola "1" o-- "1..*" Administrador : administrada por
    Escola "1" o-- "*" FuncionarioPortaria : emprega
    Escola "1" *-- "*" Aluno : matricula
    Responsavel "*" --> "1" Escola : solicita cadastro em

    Responsavel "1" *-- "*" Documento : envia
    Responsavel "1" *-- "*" Veiculo : possui
    Administrador "1" --> "*" Responsavel : valida

    Responsavel "1" --> "*" Vinculo : autorizado por
    Aluno "1" --> "*" Vinculo : tem
    Administrador "1" --> "*" Vinculo : cria e revoga

    Vinculo "1" *-- "*" QRCode : origina
    Responsavel "1" --> "*" AutorizacaoEmergencial : delega
    Aluno "1" --> "*" AutorizacaoEmergencial : refere-se a
    AutorizacaoEmergencial "1" --> "1" QRCode : gera temporário

    QRCode "1" --> "0..1" Retirada : consumido em
    Retirada "*" --> "1" Aluno : aluno retirado
    Retirada "*" --> "1" Responsavel : realizada por
    Retirada "*" --> "1" FuncionarioPortaria : validada por

    Usuario "1" --> "*" LogAuditoria : gera

    %% ===================== USO DE ENUMERAÇÕES =====================
    Usuario ..> PerfilUsuario
    Responsavel ..> StatusCadastro
    Escola ..> StatusEscola
    Vinculo ..> StatusVinculo
    QRCode ..> StatusQRCode
    QRCode ..> TipoQRCode
    Documento ..> TipoArquivo
